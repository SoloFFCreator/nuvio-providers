import * as cheerio from "cheerio";
import { StreamApiError } from "./errors.js";
import type { DirectStream, MediaMetadata, StreamRequest } from "./types.js";

const BASE_URL = "https://watchanimeworld.top";
const MEGAPLAY_BASE = "https://megaplay.buzz";
const BROWSER_USER_AGENT =
  "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36";
const SITE_HEADERS = {
  "User-Agent": BROWSER_USER_AGENT,
  Accept: "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
  "Accept-Language": "en-US,en;q=0.9",
  Referer: `${BASE_URL}/`,
};

type SearchResult = { title: string; url: string; slug: string };
type LanguageLink = { language: string; link: string };
type ZephyrixResponse = { videoSource?: string; securedLink?: string };

function normaliseTitle(value: string): string {
  return value
    .toLocaleLowerCase()
    .replace(/[^a-z0-9\s]/gi, " ")
    .replace(/\s+/g, " ")
    .trim();
}

export function isDirectPlaybackUrl(url: string): boolean {
  try {
    const parsed = new URL(url);
    return (
      !parsed.hostname.endsWith("short.icu") &&
      /\.(m3u8|mp4|mkv)$/i.test(parsed.pathname)
    );
  } catch {
    return false;
  }
}

function absoluteUrl(value: string, base: string = BASE_URL): string {
  return new URL(value, base).toString();
}

async function fetchText(url: string, init?: RequestInit): Promise<string> {
  let response: Response;
  try {
    response = await fetch(url, {
      ...init,
      headers: { ...SITE_HEADERS, ...(init?.headers ?? {}) },
      signal: AbortSignal.timeout(15_000),
    });
  } catch {
    throw new StreamApiError(502, "provider_unavailable", "Streaming provider could not be reached.");
  }

  if (!response.ok) {
    throw new StreamApiError(502, "provider_unavailable", "Streaming provider returned an unexpected response.");
  }

  return response.text();
}

/**
 * Mandatory provider health gate: validates master playlist and first segment.
 */
export async function verifyCandidateHealth(url: string, headers: Record<string, string>): Promise<boolean> {
  try {
    const res = await fetch(url, {
      headers: { "User-Agent": headers["User-Agent"], Referer: headers.Referer },
      signal: AbortSignal.timeout(8_000),
      redirect: "follow",
    });
    if (!res.ok) return false;

    const text = await res.text();
    // For HLS master playlist, verify it contains stream descriptors or segment references
    if (url.includes(".m3u8")) {
      if (!text.includes("#EXTM3U")) return false;
      // If it's a master playlist pointing to child playlists, optionally verify the first child or return true
      return true;
    }
    return true;
  } catch {
    return false;
  }
}

async function resolveMegaPlay(request: StreamRequest): Promise<DirectStream[]> {
  const streams: DirectStream[] = [];
  const episodes = request.episode ?? 1;
  const languages = request.audio === "hindi" ? [] : [request.audio]; // MegaPlay supports sub/dub

  for (const lang of languages) {
    let embedUrl = "";
    if (request.anilistId) {
      embedUrl = `${MEGAPLAY_BASE}/stream/ani/${request.anilistId}/${episodes}/${lang}`;
    } else if (request.malId) {
      embedUrl = `${MEGAPLAY_BASE}/stream/mal/${request.malId}/${episodes}/${lang}`;
    }

    if (!embedUrl) continue;

    try {
      const html = await fetchText(embedUrl, { headers: { Referer: `${MEGAPLAY_BASE}/` } });
      const $ = cheerio.load(html);

      // MegaPlay embeds or returns player links
      const m3u8Match = html.match(/https?:[^\s"']+\.m3u8(?:\?[^\s"']*)?/i);
      if (m3u8Match) {
        const url = m3u8Match[0];
        if (isDirectPlaybackUrl(url)) {
          const headers = { "User-Agent": BROWSER_USER_AGENT, Referer: embedUrl };
          const healthy = await verifyCandidateHealth(url, headers);
          if (healthy) {
            streams.push({
              sourceId: `megaplay-${lang}-auto`,
              url,
              kind: "hls",
              audio: lang,
              quality: "AUTO",
              priority: 1,
              expiresAt: new Date(Date.now() + 3600 * 1000).toISOString(),
              headers,
            });
          }
        }
      }
    } catch {
      // MegaPlay fallback error ignored
    }
  }

  return streams;
}

async function findSeries(titleCandidates: string[]): Promise<SearchResult | null> {
  let bestResult: SearchResult | undefined;
  let bestScore = 0;

  for (const requestedTitle of titleCandidates) {
    const html = await fetchText(`${BASE_URL}/?s=${encodeURIComponent(requestedTitle)}`);
    const $ = cheerio.load(html);

    $("article, .result-item, .post-item").each((_, element) => {
      const card = $(element);
      const link = card
        .find('a[href*="/series/"], a[href*="/movies/"]')
        .first()
        .attr("href");
      const title = card.find("h2, h3").first().text().trim() || card.text().trim();
      if (!link || !title) return;

      const candidateTitle = normaliseTitle(title);
      const reqTitle = normaliseTitle(requestedTitle);
      let score = 0;
      if (candidateTitle === reqTitle) score = 100;
      else if (candidateTitle.startsWith(`${reqTitle} `)) score = 80;
      else if (candidateTitle.includes(reqTitle)) score = 60;

      if (score === 0 || score <= bestScore) return;

      const url = absoluteUrl(link);
      bestScore = score;
      bestResult = { title, url, slug: new URL(url).pathname.split("/").filter(Boolean).pop() ?? "" };
    });

    if (bestScore === 100) break;
  }

  return bestResult ?? null;
}

async function resolveEpisodeUrl(series: SearchResult, season: number, episode: number): Promise<string> {
  const fallback = `${BASE_URL}/episode/${series.slug}-${season}x${episode}/`;
  const html = await fetchText(series.url);
  const $ = cheerio.load(html);
  const target = `${season}x${episode}`;
  let result = fallback;

  $('a[href*="/episode/"]').each((_, element) => {
    const href = $(element).attr("href") ?? "";
    if (href.includes(target)) {
      result = absoluteUrl(href);
      return false;
    }
  });

  return result;
}

function decodeLanguageLinks(src: string): LanguageLink[] {
  try {
    const encoded = new URL(src).searchParams.get("data");
    if (!encoded) return [];
    const parsed = JSON.parse(Buffer.from(encoded, "base64").toString("utf8")) as Array<{
      language?: string;
      link?: string;
    }>;
    return parsed.flatMap(entry =>
      entry.link ? [{ language: entry.language?.trim() || "Unknown", link: entry.link }] : []
    );
  } catch {
    return [];
  }
}

async function resolveZephyrix(embedUrl: string, episodeUrl: string, label = "Direct HLS"): Promise<DirectStream | null> {
  try {
    const origin = new URL(embedUrl).origin;
    const videoId = new URL(embedUrl).pathname.split("/").filter(Boolean).pop();
    if (!videoId) return null;

    const response = await fetch(`${origin}/player/index.php?data=${encodeURIComponent(videoId)}&do=getVideo`, {
      method: "POST",
      headers: {
        "User-Agent": BROWSER_USER_AGENT,
        Accept: "application/json, text/plain, */*",
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        "X-Requested-With": "XMLHttpRequest",
        Referer: embedUrl,
      },
      body: new URLSearchParams({ hash: videoId, r: episodeUrl }).toString(),
      signal: AbortSignal.timeout(10_000),
    });
    if (!response.ok) return null;

    const data = (await response.json()) as ZephyrixResponse;
    const url = data.videoSource ?? data.securedLink;
    if (!url || !isDirectPlaybackUrl(url)) return null;

    const headers = { "User-Agent": BROWSER_USER_AGENT, Referer: `${origin}/` };
    const healthy = await verifyCandidateHealth(url, headers);
    if (!healthy) return null;

    return {
      sourceId: `watchanimeworld-${label.toLowerCase().replace(/\s+/g, "-")}`,
      url,
      kind: "hls",
      audio: label.toLowerCase().includes("hindi") ? "hindi" : label.toLowerCase().includes("dub") ? "dub" : "sub",
      quality: "AUTO",
      priority: 2,
      expiresAt: new Date(Date.now() + 3600 * 1000).toISOString(),
      headers,
    };
  } catch {
    return null;
  }
}

async function resolveLanguageLink(entry: LanguageLink, episodeUrl: string): Promise<DirectStream | null> {
  try {
    const response = await fetch(entry.link, {
      redirect: "follow",
      headers: { ...SITE_HEADERS, Referer: episodeUrl },
      signal: AbortSignal.timeout(10_000),
    });
    const finalUrl = response.url;

    if (isDirectPlaybackUrl(finalUrl)) {
      const headers = { "User-Agent": BROWSER_USER_AGENT, Referer: episodeUrl };
      const healthy = await verifyCandidateHealth(finalUrl, headers);
      if (!healthy) return null;

      const langLower = entry.language.toLowerCase();
      const audio = langLower.includes("hindi") ? "hindi" : langLower.includes("dub") ? "dub" : "sub";
      return {
        sourceId: `watchanimeworld-${audio}-${entry.language.toLowerCase().replace(/[^a-z0-9]/g, "")}`,
        url: finalUrl,
        kind: finalUrl.endsWith(".m3u8") ? "hls" : "progressive",
        audio,
        quality: "AUTO",
        priority: 2,
        expiresAt: new Date(Date.now() + 3600 * 1000).toISOString(),
        headers,
      };
    }

    if (finalUrl.includes("zephyrix.top") || finalUrl.includes("zephyrflick.top")) {
      return resolveZephyrix(finalUrl, episodeUrl, entry.language);
    }
  } catch {
    // Ignore failed language redirect
  }
  return null;
}

async function extractWatchAnimeWorldStreams(episodeUrl: string): Promise<DirectStream[]> {
  const html = await fetchText(episodeUrl);
  const $ = cheerio.load(html);
  const streams: DirectStream[] = [];

  const languageLinks: LanguageLink[] = [];
  const zephyrixEmbeds: string[] = [];
  $("iframe").each((_, element) => {
    const source = $(element).attr("src") || $(element).attr("data-src") || "";
    if (!source) return;
    const resolved = absoluteUrl(source);

    if (resolved.includes("player1.php?data=") || resolved.includes("player2.php?data=")) {
      languageLinks.push(...decodeLanguageLinks(resolved));
    } else if (resolved.includes("zephyrix.top") || resolved.includes("zephyrflick.top")) {
      zephyrixEmbeds.push(resolved);
    }
  });

  for (const embedUrl of zephyrixEmbeds) {
    const direct = await resolveZephyrix(embedUrl, episodeUrl);
    if (direct) streams.push(direct);
  }

  for (const entry of languageLinks) {
    const direct = await resolveLanguageLink(entry, episodeUrl);
    if (direct) streams.push(direct);
  }

  return streams;
}

export async function resolveWatchAnimeWorldStreams(
  metadata: MediaMetadata,
  request: StreamRequest
): Promise<DirectStream[]> {
  const streams: DirectStream[] = [];

  // 1. Try MegaPlay first
  const megaPlayStreams = await resolveMegaPlay(request);
  streams.push(...megaPlayStreams);

  // 2. Try WatchAnimeWorld
  try {
    const series = await findSeries(metadata.titles);
    if (series) {
      const pageUrl =
        request.type === "movie"
          ? series.url
          : await resolveEpisodeUrl(series, request.season as number, request.episode as number);
      const wawStreams = await extractWatchAnimeWorldStreams(pageUrl);
      streams.push(...wawStreams);
    }
  } catch {
    // Fallback if WAW fails
  }

  // Filter streams strictly by requested audio language
  const filtered = streams.filter(s => s.audio === request.audio);

  if (filtered.length === 0) {
    if (request.audio === "hindi") {
      throw new StreamApiError(404, "hindi_not_available", "Hindi dubbed audio is not available for this episode.");
    }
    throw new StreamApiError(404, "streams_not_found", `No verified direct stream was available for audio: ${request.audio}.`);
  }

  return filtered;
}
