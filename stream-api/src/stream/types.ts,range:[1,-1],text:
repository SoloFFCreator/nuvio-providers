export type MediaType = "movie" | "tv";
export type AudioLanguage = "sub" | "dub" | "hindi";

export type StreamRequest = {
  anilistId?: number;
  malId?: number;
  type: MediaType;
  season?: number;
  episode?: number;
  audio: AudioLanguage;
};

export type DirectStream = {
  sourceId: string;
  url: string;
  kind: "hls" | "progressive";
  audio: AudioLanguage;
  quality: string;
  priority: number;
  expiresAt: string;
  headers: {
    "User-Agent": string;
    Referer: string;
  };
};

export type StreamResponse = {
  requestId: string;
  audio: AudioLanguage;
  sources: DirectStream[];
};

export type MediaMetadata = {
  primaryTitle: string;
  titles: string[];
};

export const ALLOWED_ANDROID_PACKAGES = ["com.midnight.anime", "com.midnight.anime.tv"] as const;
export type AllowedAndroidPackage = (typeof ALLOWED_ANDROID_PACKAGES)[number];
